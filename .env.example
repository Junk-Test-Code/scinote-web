# ============================================================================
# SciNote Docker Compose Configuration
# ============================================================================
# Copy this file to .env and configure with your settings

# ============================================================================
# SECRET KEY BASE (REQUIRED)
# ============================================================================
# Generate a secure random string for this:
# ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=change_this_to_a_secure_random_string_at_least_64_characters_long

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scinote_production
POSTGRES_PORT=54329

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis Port
REDIS_PORT=63791

# ============================================================================
# WEB APPLICATION CONFIGURATION
# ============================================================================
# Web Application Port
WEB_PORT=37842

# Application URL (update with your domain)
APPLICATION_URL=http://localhost:37842
APPLICATION_NAME=SciNote

# ============================================================================
# S3 STORAGE CONFIGURATION (REQUIRED)
# ============================================================================
# Choose your S3 provider below and configure accordingly
# Supports: AWS, DigitalOcean, Wasabi, MinIO, Backblaze B2, and more

# Active Storage Service
ACTIVESTORAGE_SERVICE=amazon

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_REGION=us-east-1
S3_BUCKET=your_bucket_name
S3_SUBFOLDER=scinote

# ============================================================================
# S3-COMPATIBLE SERVICES (Optional)
# ============================================================================
# Uncomment and configure for S3-compatible services

# DigitalOcean Spaces
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_spaces_access_key
# AWS_SECRET_ACCESS_KEY=your_spaces_secret_key
# S3_BUCKET=your_spaces_name

# Wasabi
# AWS_ENDPOINT=https://s3.wasabisys.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_wasabi_access_key
# AWS_SECRET_ACCESS_KEY=your_wasabi_secret_key
# S3_BUCKET=your_wasabi_bucket_name

# MinIO (Self-hosted)
# AWS_ENDPOINT=http://minio-server:9000
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_minio_access_key
# AWS_SECRET_ACCESS_KEY=your_minio_secret_key
# S3_BUCKET=scinote

# Backblaze B2
# AWS_ENDPOINT=https://s3.us-west-000.backblazeb2.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_b2_key_id
# AWS_SECRET_ACCESS_KEY=your_b2_application_key
# S3_BUCKET=your_b2_bucket_name

# Google Cloud Storage (via MinIO gateway)
# AWS_ENDPOINT=https://storage.googleapis.com
# AWS_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=your_gcs_access_key
# AWS_SECRET_ACCESS_KEY=your_gcs_secret_key
# S3_BUCKET=your_gcs_bucket_name

# Oracle Cloud Object Storage
# AWS_ENDPOINT=https://your_namespace.compat.objectstorage.region.oraclecloud.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_oracle_access_key
# AWS_SECRET_ACCESS_KEY=your_oracle_secret_key
# S3_BUCKET=your_oracle_bucket_name

# Scaleway Object Storage
# AWS_ENDPOINT=https://s3.nl-ams.scw.cloud
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_scaleway_access_key
# AWS_SECRET_ACCESS_KEY=your_scaleway_secret_key
# S3_BUCKET=your_scaleway_bucket_name

# Linode Object Storage
# AWS_ENDPOINT=https://us-east-1.linodeobjects.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_linode_access_key
# AWS_SECRET_ACCESS_KEY=your_linode_secret_key
# S3_BUCKET=your_linode_bucket_name

# Alibaba Cloud OSS
# AWS_ENDPOINT=https://oss-us-west-1.aliyuncs.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_aliyun_access_key
# AWS_SECRET_ACCESS_KEY=your_aliyun_secret_key
# S3_BUCKET=your_aliyun_bucket_name

# IDrive e2
# AWS_ENDPOINT=https://d5w58b88j7sb.cloudwayscdn.com
# AWS_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=your_idrive_access_key
# AWS_SECRET_ACCESS_KEY=your_idrive_secret_key
# S3_BUCKET=your_idrive_bucket_name

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# Configure SMTP settings for email notifications
# MAIL_SERVER_URL=smtp.gmail.com
# MAIL_SERVER_PORT=587
# MAIL_SERVER_USERNAME=your_email@gmail.com
# MAIL_SERVER_PASSWORD=your_app_password
# MAIL_FROM=noreply@scinote.net

# ============================================================================
# PERFORMANCE TUNING (Optional)
# ============================================================================
# Adjust these based on your server resources
DB_POOL=25
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2