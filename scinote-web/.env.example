# =============================================================================
# SciNote Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY - REQUIRED
# -----------------------------------------------------------------------------
# Generate a secure random key with: openssl rand -hex 64
# This MUST be changed for production deployments
SECRET_KEY_BASE=your_secret_key_base_here_change_this_in_production

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=scinote_production
DB_POOL=25

# -----------------------------------------------------------------------------
# S3 STORAGE CONFIGURATION - REQUIRED FOR IMAGE UPLOADS
# -----------------------------------------------------------------------------
# Storage Service Type
# Options: amazon (S3-compatible), local (for development/testing)
ACTIVESTORAGE_SERVICE=amazon

# S3 Provider Configuration
# Choose your S3 provider and configure accordingly

# Your S3 Access Key ID
AWS_ACCESS_KEY_ID=your_access_key_id

# Your S3 Secret Access Key
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Region where your bucket is located
AWS_REGION=us-east-1

# S3 Region (can be different from AWS_REGION for some providers)
S3_REGION=us-east-1

# S3 Bucket name for storing uploaded files
S3_BUCKET=your-scinote-bucket

# Optional: Subfolder within the bucket (useful for organizing files)
S3_SUBFOLDER=scinote

# -----------------------------------------------------------------------------
# S3-COMPATIBLE SERVICES CONFIGURATION
# -----------------------------------------------------------------------------
# Set AWS_ENDPOINT to use S3-compatible services instead of AWS S3
# Uncomment and configure the appropriate provider below:

# DigitalOcean Spaces Example:
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1

# Wasabi Example:
# AWS_ENDPOINT=https://s3.wasabisys.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1

# MinIO Example (Self-hosted):
# AWS_ENDPOINT=http://minio-server:9000
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1

# Backblaze B2 Example:
# AWS_ENDPOINT=https://s3.us-west-000.backblazeb2.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-west-000

# Alibaba Cloud OSS Example:
# AWS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=cn-hangzhou

# Google Cloud Storage (via S3 compatibility):
# AWS_ENDPOINT=https://storage.googleapis.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=auto

# Oracle Cloud Object Storage:
# AWS_ENDPOINT=https://objectstorage.region.oraclecloud.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-ashburn-1

# Scaleway Object Storage:
# AWS_ENDPOINT=https://s3.fr-par.scw.cloud
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=fr-par

# Linode Object Storage:
# AWS_ENDPOINT=https://us-southeast-1.linodeobjects.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-southeast-1

# IDrive e2:
# AWS_ENDPOINT=https://e2.wasabisys.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1

# Tenable Object Storage:
# AWS_ENDPOINT=https://s3.tenable.com
# AWS_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1

# Note: For AWS S3, leave AWS_ENDPOINT empty and set AWS_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# The public URL where SciNote will be accessible
APPLICATION_URL=http://localhost:37842

# Application name displayed in the UI
APPLICATION_NAME=SciNote

# Port to expose the web application (default: 37842)
# Using unique random port to avoid conflicts with other services
WEB_PORT=37842

# Port to expose PostgreSQL database (default: 54329)
# Using unique random port to avoid conflicts with other PostgreSQL instances
POSTGRES_PORT=54329

# Port to expose Redis (default: 63791)
# Using unique random port to avoid conflicts with other Redis instances
REDIS_PORT=63791

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional but recommended)
# -----------------------------------------------------------------------------
# SMTP server for sending emails
MAIL_SERVER_URL=smtp.example.com
MAIL_SERVER_PORT=587

# SMTP authentication
MAIL_SERVER_USERNAME=your_smtp_username
MAIL_SERVER_PASSWORD=your_smtp_password

# From address for outgoing emails
MAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING (Optional)
# -----------------------------------------------------------------------------
# Number of Rails threads per process
RAILS_MAX_THREADS=5

# Number of web server processes
WEB_CONCURRENCY=2

# -----------------------------------------------------------------------------
# PORT CONFIGURATION
# -----------------------------------------------------------------------------
# All ports are set to unique random values to avoid conflicts with other services
# - WEB_PORT (37842): Main application web interface
# - POSTGRES_PORT (54329): PostgreSQL database (for external management tools)
# - REDIS_PORT (63791): Redis cache (for external monitoring tools)
#
# Security Note: In production, consider removing port mappings for PostgreSQL
# and Redis from docker-compose.yml if external access is not needed.

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 1. S3 Configuration:
#    - Create an S3 bucket in your AWS account
#    - Configure bucket permissions to allow read/write access
#    - Set appropriate CORS configuration if accessing from browser
#    - Consider enabling versioning for data protection
#
# 2. IAM Permissions Required:
#    - s3:PutObject
#    - s3:GetObject
#    - s3:DeleteObject
#    - s3:ListBucket
#
# 3. For S3-compatible services (MinIO, DigitalOcean Spaces, etc.):
#    - Set AWS_ENDPOINT to your service endpoint
#    - Use the service's access key and secret key
#    - Ensure the endpoint URL includes the protocol (https://)
#
# 4. Security Best Practices:
#    - Use strong, unique passwords
#    - Rotate credentials regularly
#    - Use IAM roles with minimal required permissions
#    - Enable S3 bucket encryption
#    - Configure bucket policies to restrict access
#
# 5. Backup Strategy:
#    - Enable S3 versioning for file recovery
#    - Configure automated database backups
#    - Test restore procedures regularly